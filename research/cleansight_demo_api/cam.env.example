# Mau cau hinh cho Camera lab. SAO CHEP thanh cam.env (cung thu muc) va dien gia tri THAT.
# cam.env da nam trong .gitignore: KHONG dua file that len Git (repo cong khai).
#
# Ma truy cap vao trang camera (tu dat; nguoi dung nhap o man hinh dang nhap)
CLEANSIGHT_CAM_ACCESS_CODE=doi-thanh-ma-cua-ban
# Khoa rieng cho cau noi gui anh (chuoi ngau nhien dai >= 16 ky tu; KHONG trung ma truy cap)
CLEANSIGHT_CAM_INGEST_KEY=doi-thanh-chuoi-ngau-nhien-dai
# Thu muc luu anh (de trong = %USERPROFILE%\CleanSightCamData). Phai nam NGOAI thu muc repo.
# CLEANSIGHT_CAM_DATA_DIR=D:\CleanSightCamData
